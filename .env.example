# Public browser config (Vite exposes only VITE_-prefixed names). Leave empty for Offline Demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets are NOT set here. They are edge-function secrets set in the Bolt / Supabase dashboard,
# never with a VITE_ prefix and never committed:
#   ANTHROPIC_API_KEY
#   OPENAI_COMPATIBLE_API_KEY
#   OPENAI_COMPATIBLE_BASE_URL            (operator-only)
#   REWRITE_MODEL_ID
#   JUDGE_MODEL_ID
#   MODEL_PRICE_IN_MICRO_USD_PER_MTOK
#   MODEL_PRICE_OUT_MICRO_USD_PER_MTOK
#   LIVE_CALLS_ENABLED                    ('true' to allow paid calls)
#   LLM_JUDGE_ENABLED
#   APP_ORIGIN
# Injected by Supabase into functions (do not set manually): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
